# Copy ke .env dan isi nilai sebenarnya. .env di-gitignore, aman dari commit.

# --- Sumopod (LLM API, OpenAI-compatible) ---------------------------------
# Dapatkan di ai.sumopod.com -> tab AI -> API Keys
SUMOPOD_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Belum terverifikasi 100% - cek ulang base URL yang benar di dashboard Sumopod
# sebelum deploy (lihat catatan di hermes-agent/main.py)
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=gpt-4o-mini

# --- Solar dashboard (D:\ht\test) -----------------------------------------
# Generate dengan: openssl rand -hex 24
# HARUS sama dengan `ingest_token` di D:\ht\test\esphome\secrets.yaml
SOLAR_INGEST_TOKEN=ganti-token-ini

# --- Wiring antar service ---------------------------------------------------
MAIL_WEBHOOK_URL=http://hermes-agent:8000/webhook/mail
SOLAR_DASHBOARD_URL=http://solar-dashboard:3000

# --- Otomasi baterai (opsional, dipakai hermes-agent solar watcher) -------
SOC_LOW_THRESHOLD=20
SOC_HIGH_THRESHOLD=95
SOLAR_POLL_SECONDS=60

# --- Appium (host, bukan container) ----------------------------------------
APPIUM_SERVER_URL=http://localhost:4723

# --- Telegram (opsional, kosongkan untuk nonaktifkan notifikasi) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Transkripsi file rekaman Notulen (endpoint OpenAI-compatible /audio/transcriptions di SUMOPOD_BASE_URL).
# Bila model/endpoint tidak didukung, otomatis jatuh ke Google Web Speech (butuh ffmpeg di server).
STT_MODEL=whisper-1

# Mesin transkripsi file rekaman, dicoba berurutan (Sumopod tidak punya model Whisper/STT, jadi gemini lewat chat audio dipakai dulu).
STT_ENGINES=gemini,ai,google
STT_CHAT_MODEL=gemini/gemini-3.1-flash-lite

# Endpoint KHUSUS audio (transkripsi + analisa audio langsung). Kosongkan = pakai SUMOPOD_*.
# Contoh memakai 9Router hanya untuk speech-to-text; LLM teks (briefing, chat, ringkasan) tetap di Sumopod:
# Setup 9Router: bash 9router/setup.sh (lihat README di bagian 9Router). Lalu:
# STT_BASE_URL=http://127.0.0.1:20128/v1
# STT_API_KEY=isi-kunci-9router
# STT_CHAT_MODEL=gc/gemini-2.5-flash      # model audioInput yang provider-nya sudah tersambung di dashboard
# STT_ENGINES=gemini,google               # (tambahkan 'ai' bila memakai whisper self-hosted lewat 9Router, set STT_MODEL)

# --- Email keluar (SMTP): lupa kata sandi, email uji, briefing harian opsional ---------------------------
# Cloudflare Tunnel hanya melayani web. Email keluar lewat relay SMTP (Brevo, Resend, Amazon SES, Gmail App Password, dll.).
# Setelah mengisi, restart powmr + hermes-agent, lalu uji di menu Sistem -> Layanan Email -> "Kirim email uji".
SMTP_HOST=
SMTP_PORT=587                  # 587 = STARTTLS, 465 = SSL
SMTP_SECURITY=                 # starttls | ssl | none (kosong = otomatis dari port)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Westpro <no-reply@westpro.my.id>   # domain pengirim harus lolos SPF/DKIM penyedia
MAIL_REPLY_TO=
PUBLIC_BASE_URL=https://westpro.my.id        # dipakai untuk tautan di email (bukan dari header Host)

# --- Westpro Mail: terima email ke banyak alamat @domain (Cloudflare Email Routing -> Email Worker -> webhook) ----
# Isi dengan string acak panjang (openssl rand -hex 32); nilai yang SAMA dipasang sebagai Secret di Cloudflare Worker.
MAIL_INBOUND_SECRET=
MAIL_DOMAIN=                     # kosong = host dari PUBLIC_BASE_URL (westpro.my.id)
